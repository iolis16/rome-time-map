SELECT ?item ?itemLabel ?coord ?inception ?prec ?dissolved ?classLabel ?article WHERE {
  {
    SELECT DISTINCT ?item ?coord ?inception ?prec WHERE {
      SERVICE wikibase:box {
        ?item wdt:P625 ?coord .
        bd:serviceParam wikibase:cornerSouthWest "Point(12.38 41.81)"^^geo:wktLiteral .
        bd:serviceParam wikibase:cornerNorthEast "Point(12.60 41.97)"^^geo:wktLiteral .
      }
      ?item p:P571/psv:P571 ?iv .
      ?iv wikibase:timeValue ?inception ; wikibase:timePrecision ?prec .
      FILTER(?prec >= 7)
      ?item wdt:P31/wdt:P279* ?root .
      VALUES ?root { wd:Q811979 wd:Q839954 wd:Q4989906 wd:Q16560 wd:Q16970 wd:Q44539 wd:Q483110 wd:Q12280 wd:Q41176 wd:Q4376769 wd:Q179700 wd:Q2065736 }
    }
  }
  OPTIONAL { ?item wdt:P31 ?class }
  OPTIONAL { ?item wdt:P576 ?dissolved }
  OPTIONAL { ?article schema:about ?item ; schema:isPartOf <https://en.wikipedia.org/> }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en,it,la". }
}
